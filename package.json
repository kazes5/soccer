{
  "name": "soccer-carpool",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api,worker -c blue,green,magenta \"pnpm --filter @soccer/web dev\" \"pnpm --filter @soccer/api dev\" \"pnpm --filter @soccer/api worker:dev\"",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit",
    "secrets:scan": "secretlint --secretlintignore .gitignore \"**/*\"",
    "db:generate": "pnpm --filter @soccer/api run db:generate",
    "db:migrate": "pnpm --filter @soccer/api run db:migrate",
    "db:migrate:deploy": "pnpm --filter @soccer/api run db:migrate:deploy",
    "db:seed": "pnpm --filter @soccer/api run db:seed",
    "system-admin:grant": "pnpm --filter @soccer/api run system-admin:grant --",
    "test:e2e": "pnpm --filter @soccer/e2e run db:setup && pnpm --filter @soccer/e2e run e2e",
    "test:integration": "pnpm --filter @soccer/api run test:integration",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "concurrently": "^10.0.4",
    "prettier": "^3.9.6",
    "secretlint": "^13.0.4",
    "typescript": "^6.0.3"
  }
}
