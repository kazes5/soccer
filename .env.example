# Read by docker-compose.yml when running `pnpm docker:up` from the repo root.
# Copy to .env and adjust if you need non-default local Postgres/Redis credentials.
# apps/api and apps/web have their own .env.example files with app-specific variables.

POSTGRES_USER=soccer
POSTGRES_PASSWORD=soccer
POSTGRES_DB=soccer_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
