generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  parent
  admin
}

enum SystemRole {
  system_admin
}

enum AuthMethod {
  bootstrap
  password
  passkey
}

enum Language {
  en
  he
}

enum NotificationChannel {
  push
  sms
  email
}

enum WebauthnChallengeType {
  registration
  authentication
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

enum AuditSource {
  app
  ai_chat
}

enum CollectionPointType {
  pickup
  dropoff
  both
}

enum ShiftDirection {
  to_practice
  from_practice
}

enum SessionStatus {
  scheduled
  completed
  cancelled
}

enum ShiftStatus {
  open
  claimed
  pending_swap
}

enum NotificationCategory {
  shift_changes
  swaps
  reminders
  escalations
  admin_changes
}

/**
 * Which of the three recipient-resolution shapes ADR 0001 declares applies
 * to an `OutboxEvent` — the worker reads this to know how to fan the event
 * out, instead of each event type re-deriving its own recipient logic.
 */
enum RecipientScope {
  team_broadcast
  participants
  self
}

/**
 * Emergency events (a "can't make it" flag, auto-escalation) bypass quiet
 * hours and the collapse/throttle rules that apply to everything else.
 */
enum NotificationSeverity {
  normal
  emergency
}

enum DeliveryChannel {
  in_app
  push
  sms
  email
}

enum ScheduledTaskType {
  reminder
  escalation
  swap_expiry
}

enum SwapRequestStatus {
  pending
  accepted
  declined
  expired
  cancelled
}

model User {
  id                 String      @id @default(uuid())
  name               String
  phone              String?     @unique
  email              String?     @unique
  normalizedPhone    String?     @unique @map("normalized_phone")
  normalizedEmail    String?     @unique @map("normalized_email")
  systemRole         SystemRole? @map("system_role")
  languagePreference Language    @default(en) @map("language_preference")
  isActive           Boolean     @default(true) @map("is_active")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  teamMemberships            TeamMember[]
  playerLinks                PlayerParent[]
  sentInvites                Invite[]                     @relation("InvitesCreated")
  acceptedInvites            Invite[]                     @relation("InvitesAccepted")
  passkeys                   Passkey[]
  passwordCredential         PasswordCredential?
  passwordResetTokens        PasswordResetToken[]
  passwordLoginAttempts      PasswordLoginAttempt[]
  webauthnChallenges         WebauthnChallenge[]
  sessions                   Session[]
  notificationPrefs          NotificationPreference[]
  auditLogEntries            AuditLog[]                   @relation("AuditActor")
  systemAuditLogEntries      SystemAuditLog[]             @relation("SystemAuditActor")
  pushSubscriptions          PushSubscription[]
  scheduleTemplates          ScheduleTemplate[]           @relation("ScheduleTemplatesCreated")
  assignedShifts             Shift[]                      @relation("ShiftsAssigned")
  memberNotificationSettings MemberNotificationSettings[]
  userNotifications          UserNotification[]
  swapRequestsSent           SwapRequest[]                @relation("SwapRequestsRequested")
  swapRequestsReceived       SwapRequest[]                @relation("SwapRequestsHeld")

  @@map("users")
}

model Team {
  id        String   @id @default(uuid())
  name      String
  season    String
  timezone  String   @default("Asia/Jerusalem")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members                    TeamMember[]
  players                    Player[]
  invites                    Invite[]
  notificationPrefs          NotificationPreference[]
  auditLogEntries            AuditLog[]
  collectionPoints           CollectionPoint[]
  scheduleTemplates          ScheduleTemplate[]
  practiceSessions           PracticeSession[]
  coordinationSettings       CoordinationSettings?
  notificationSettings       TeamNotificationSettings?
  memberNotificationSettings MemberNotificationSettings[]
  outboxEvents               OutboxEvent[]
  userNotifications          UserNotification[]
  scheduledTasks             ScheduledTask[]
  swapRequests               SwapRequest[]

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  role     TeamRole @default(parent)
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Player {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  name      String
  age       Int?
  createdAt DateTime @default(now()) @map("created_at")

  team    Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parents PlayerParent[]

  @@index([teamId])
  @@map("players")
}

model PlayerParent {
  id           String @id @default(uuid())
  playerId     String @map("player_id")
  userId       String @map("user_id")
  relationship String @default("parent")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playerId, userId])
  @@index([userId])
  @@map("player_parents")
}

model Invite {
  id                    String       @id @default(uuid())
  teamId                String       @map("team_id")
  code                  String       @unique
  codeVersion           Int          @default(1) @map("code_version")
  onboardingCodeHash    String?      @map("onboarding_code_hash")
  failedCodeAttempts    Int          @default(0) @map("failed_code_attempts")
  lastFailedCodeAt      DateTime?    @map("last_failed_code_at")
  verificationTokenHash String?      @map("verification_token_hash")
  verificationExpiresAt DateTime?    @map("verification_expires_at")
  phone                 String?
  email                 String?
  status                InviteStatus @default(pending)
  createdByUserId       String       @map("created_by_user_id")
  acceptedByUserId      String?      @map("accepted_by_user_id")
  expiresAt             DateTime     @map("expires_at")
  acceptedAt            DateTime?    @map("accepted_at")
  createdAt             DateTime     @default(now()) @map("created_at")

  team           Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy      User  @relation("InvitesCreated", fields: [createdByUserId], references: [id])
  acceptedByUser User? @relation("InvitesAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@map("invites")
}

model Passkey {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    Bytes    @map("public_key")
  counter      Int
  transports   String[]
  deviceType   String   @map("device_type")
  backedUp     Boolean  @map("backed_up")
  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model PasswordCredential {
  userId            String   @id @map("user_id")
  passwordHash      String   @map("password_hash")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PasswordLoginAttempt {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  identifierHash String   @map("identifier_hash")
  requestIp      String   @map("request_ip")
  succeeded      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifierHash, createdAt])
  @@index([requestIp, createdAt])
  @@map("password_login_attempts")
}

model WebauthnChallenge {
  id         String                @id @default(uuid())
  userId     String                @map("user_id")
  type       WebauthnChallengeType
  challenge  String
  requestIp  String?               @map("request_ip")
  expiresAt  DateTime              @map("expires_at")
  consumedAt DateTime?             @map("consumed_at")
  createdAt  DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([requestIp, createdAt])
  @@map("webauthn_challenges")
}

model Session {
  id              String     @id @default(uuid())
  userId          String     @map("user_id")
  tokenHash       String     @unique @map("token_hash")
  expiresAt       DateTime   @map("expires_at")
  revokedAt       DateTime?  @map("revoked_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  lastUsedAt      DateTime   @default(now()) @map("last_used_at")
  authMethod      AuthMethod @default(bootstrap) @map("auth_method")
  authenticatedAt DateTime   @default(now()) @map("authenticated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model NotificationPreference {
  id       String               @id @default(uuid())
  userId   String               @map("user_id")
  teamId   String               @map("team_id")
  category NotificationCategory
  channel  NotificationChannel
  enabled  Boolean              @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId, category, channel])
  @@index([teamId])
  @@map("notification_preferences")
}

model CoordinationSettings {
  teamId                String   @id @map("team_id")
  swapExpiryHours       Int      @default(24) @map("swap_expiry_hours")
  reminderOffsetMinutes Int[]    @default([1440, 120]) @map("reminder_offset_minutes")
  escalationLeadMinutes Int      @default(120) @map("escalation_lead_minutes")
  updatedAt             DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("coordination_settings")
}

/**
 * Team-wide default quiet-hours window — the fallback for any member who
 * hasn't set a personal override on `MemberNotificationSettings`.
 */
model TeamNotificationSettings {
  teamId          String   @id @map("team_id")
  quietHoursStart String   @default("22:00") @map("quiet_hours_start")
  quietHoursEnd   String   @default("07:00") @map("quiet_hours_end")
  updatedAt       DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_notification_settings")
}

/**
 * Per-member overrides of the team defaults above. `null` quiet-hours fields
 * and an empty `reminderOffsetMinutes` array both mean "no override — use the
 * team default", not "explicitly disabled".
 */
model MemberNotificationSettings {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  teamId                String   @map("team_id")
  quietHoursStart       String?  @map("quiet_hours_start")
  quietHoursEnd         String?  @map("quiet_hours_end")
  reminderOffsetMinutes Int[]    @default([]) @map("reminder_offset_minutes")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@map("member_notification_settings")
}

/**
 * One row per team-visible mutation, written in the same transaction as the
 * mutation and its `AuditLog` entry (see ADR 0001). The worker fans this out
 * into one `UserNotification` per resolved recipient; `processedAt` is the
 * source of truth for "has this actually been handled" — BullMQ jobs are
 * just the trigger, re-enqueued freely from a null `processedAt` on restart.
 */
model OutboxEvent {
  id                 String               @id @default(uuid())
  teamId             String               @map("team_id")
  eventType          String               @map("event_type")
  category           NotificationCategory
  severity           NotificationSeverity @default(normal)
  /**
   * Set only when the acting user should get the in-app record like every
   * other recipient but not a redundant push about their own action (see
   * `push-delivery.ts`) — currently only swap-lifecycle events set this;
   * every other event type leaves it null, which is a no-op for push
   * delivery (nobody gets excluded).
   */
  actorId            String?              @map("actor_id")
  recipientScope     RecipientScope       @map("recipient_scope")
  /**
   * Populated only when `recipientScope = participants`.
   */
  participantUserIds String[]             @default([]) @map("participant_user_ids")
  /**
   * Populated only when `recipientScope = self`.
   */
  selfUserId         String?              @map("self_user_id")
  payload            Json
  attempts           Int                  @default(0)
  lastError          String?              @map("last_error")
  processedAt        DateTime?            @map("processed_at")
  createdAt          DateTime             @default(now()) @map("created_at")

  team          Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  notifications UserNotification[]

  @@index([processedAt])
  @@index([teamId, createdAt])
  @@map("outbox_events")
}

/**
 * One row per (event, recipient) — the durable in-app record. Unlike push,
 * in-app history can't be disabled per ADR 0001, so creating this row *is*
 * the in-app delivery, not a queue of something still to send.
 */
model UserNotification {
  id            String               @id @default(uuid())
  outboxEventId String               @map("outbox_event_id")
  userId        String               @map("user_id")
  teamId        String               @map("team_id")
  eventType     String               @map("event_type")
  category      NotificationCategory
  severity      NotificationSeverity @default(normal)
  payload       Json
  readAt        DateTime?            @map("read_at")
  dismissedAt   DateTime?            @map("dismissed_at")
  createdAt     DateTime             @default(now()) @map("created_at")

  outboxEvent OutboxEvent            @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  deliveries  NotificationDelivery[]

  // Makes the fan-out step idempotent: reprocessing an event after a crash
  // can't create a second notification for a recipient who already got one.
  @@unique([outboxEventId, userId])
  @@index([userId, teamId, createdAt])
  @@map("user_notifications")
}

/**
 * Per-channel delivery record for a `UserNotification` — answers "did this
 * actually go out" instead of assuming. Push/SMS/email delivery isn't wired
 * until later checkpoints; this checkpoint only ever writes `in_app` rows,
 * created (and immediately marked delivered) alongside their notification.
 */
model NotificationDelivery {
  id                 String          @id @default(uuid())
  userNotificationId String          @map("user_notification_id")
  channel            DeliveryChannel
  attempts           Int             @default(0)
  lastError          String?         @map("last_error")
  deliveredAt        DateTime?       @map("delivered_at")
  createdAt          DateTime        @default(now()) @map("created_at")

  userNotification UserNotification @relation(fields: [userNotificationId], references: [id], onDelete: Cascade)

  @@unique([userNotificationId, channel])
  @@map("notification_deliveries")
}

/**
 * A durable, delayed unit of future work (a reminder or escalation firing
 * at `runAt`) — scheduled via a delayed BullMQ job keyed by this row's own
 * id, reconciled the same way as `OutboxEvent`. No concrete task type has
 * real business logic yet: reminders land in Checkpoint 9, escalation in
 * Checkpoint 10. This checkpoint only proves the schedule -> delayed job ->
 * processor -> `completedAt` plumbing is correct and idempotent.
 */
model ScheduledTask {
  id          String            @id @default(uuid())
  teamId      String            @map("team_id")
  type        ScheduledTaskType
  payload     Json
  runAt       DateTime          @map("run_at")
  attempts    Int               @default(0)
  lastError   String?           @map("last_error")
  cancelledAt DateTime?         @map("cancelled_at")
  completedAt DateTime?         @map("completed_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([completedAt, cancelledAt, runAt])
  @@map("scheduled_tasks")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AuditLog {
  id           String      @id @default(uuid())
  teamId       String      @map("team_id")
  actorId      String?     @map("actor_id")
  actionType   String      @map("action_type")
  targetEntity String      @map("target_entity")
  targetId     String?     @map("target_id")
  beforeState  Json?       @map("before_state")
  afterState   Json?       @map("after_state")
  source       AuditSource @default(app)
  aiContext    Json?       @map("ai_context")
  createdAt    DateTime    @default(now()) @map("created_at")

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([actorId])
  @@index([actionType])
  @@map("audit_logs")
}

model SystemAuditLog {
  id           String      @id @default(uuid())
  actorId      String?     @map("actor_id")
  actionType   String      @map("action_type")
  targetEntity String      @map("target_entity")
  targetId     String?     @map("target_id")
  teamId       String?     @map("team_id")
  beforeState  Json?       @map("before_state")
  afterState   Json?       @map("after_state")
  source       AuditSource @default(app)
  createdAt    DateTime    @default(now()) @map("created_at")

  actor User? @relation("SystemAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([teamId])
  @@index([actionType])
  @@map("system_audit_logs")
}

model CollectionPoint {
  id        String              @id @default(uuid())
  teamId    String              @map("team_id")
  name      String
  address   String
  gpsLat    Decimal?            @map("gps_lat") @db.Decimal(10, 8)
  gpsLng    Decimal?            @map("gps_lng") @db.Decimal(11, 8)
  type      CollectionPointType
  createdAt DateTime            @default(now()) @map("created_at")

  team               Team                              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  templateDefaults   ScheduleTemplateCollectionPoint[]
  sessionAssignments SessionPointAssignment[]
  shifts             Shift[]

  @@index([teamId])
  @@map("collection_points")
}

model ScheduleTemplate {
  id                   String   @id @default(uuid())
  teamId               String   @map("team_id")
  recurrenceRule       String   @map("recurrence_rule")
  startDate            DateTime @map("start_date") @db.Date
  defaultTime          String   @map("default_time")
  defaultFieldLocation String   @map("default_field_location")
  horizonWeeks         Int      @default(8) @map("horizon_weeks")
  createdByUserId      String   @map("created_by_user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  team             Team                              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy        User                              @relation("ScheduleTemplatesCreated", fields: [createdByUserId], references: [id])
  collectionPoints ScheduleTemplateCollectionPoint[]
  sessions         PracticeSession[]

  @@index([teamId])
  @@map("schedule_templates")
}

model ScheduleTemplateCollectionPoint {
  id         String @id @default(uuid())
  templateId String @map("template_id")
  pointId    String @map("point_id")

  template ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  point    CollectionPoint  @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([templateId, pointId])
  @@map("schedule_template_collection_points")
}

model PracticeSession {
  id            String        @id @default(uuid())
  teamId        String        @map("team_id")
  templateId    String?       @map("template_id")
  startsAt      DateTime      @map("starts_at")
  fieldLocation String        @map("field_location")
  status        SessionStatus @default(scheduled)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  team        Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  template    ScheduleTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignments SessionPointAssignment[]
  shifts      Shift[]

  @@unique([templateId, startsAt])
  @@index([teamId, startsAt])
  @@map("practice_sessions")
}

model SessionPointAssignment {
  id        String         @id @default(uuid())
  sessionId String         @map("session_id")
  pointId   String         @map("point_id")
  direction ShiftDirection
  playerIds String[]       @map("player_ids")

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  point   CollectionPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([sessionId, pointId, direction])
  @@index([pointId])
  @@map("session_point_assignments")
}

model Shift {
  id             String         @id @default(uuid())
  sessionId      String         @map("session_id")
  pointId        String         @map("point_id")
  direction      ShiftDirection
  assignedUserId String?        @map("assigned_user_id")
  status         ShiftStatus    @default(open)
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  session      PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  point        CollectionPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  assignedUser User?           @relation("ShiftsAssigned", fields: [assignedUserId], references: [id], onDelete: SetNull)
  swapRequests SwapRequest[]

  @@unique([sessionId, pointId, direction])
  @@index([pointId])
  @@index([assignedUserId])
  @@map("shifts")
}

/**
 * A one-way request from `requestingUser` to take over `currentHolder`'s
 * claimed shift — CLAUDE.md §3.4's swap-consent flow. The shift stays
 * assigned to `currentHolder` (status flips `claimed` -> `pending_swap`,
 * blocking a competing claim/release/second-request on it) until this
 * resolves one of four ways: `currentHolder` accepts (shift reassigns) or
 * declines, `requestingUser` cancels, or it expires unresolved
 * (`CoordinationSettings.swapExpiryHours` after creation, capped at the
 * session's start time — a `ScheduledTask` of type `swap_expiry` drives
 * this). Only one `pending` row may exist per shift at a time — enforced by
 * both the `Shift.status` CAS on creation (primary guard: a second request
 * can't even start once the first has flipped the shift to `pending_swap`)
 * and a partial unique index added by hand in this model's migration
 * (`swap_requests_pending_shift_unique`, `WHERE status = 'pending'` — not
 * expressible in the Prisma schema DSL), per PLAN.md's explicit "enforce
 * with a database constraint" instruction — defense in depth, not the only
 * guard.
 */
model SwapRequest {
  id               String            @id @default(uuid())
  teamId           String            @map("team_id")
  shiftId          String            @map("shift_id")
  requestingUserId String            @map("requesting_user_id")
  currentHolderId  String            @map("current_holder_id")
  status           SwapRequestStatus @default(pending)
  expiresAt        DateTime          @map("expires_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  team           Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  shift          Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  requestingUser User  @relation("SwapRequestsRequested", fields: [requestingUserId], references: [id])
  currentHolder  User  @relation("SwapRequestsHeld", fields: [currentHolderId], references: [id])

  @@index([shiftId])
  @@index([teamId, status])
  @@index([requestingUserId])
  @@index([currentHolderId])
  @@map("swap_requests")
}
