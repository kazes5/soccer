generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeamRole {
  parent
  admin
}

enum Language {
  en
  he
}

enum NotificationChannel {
  push
  sms
  email
}

enum OtpChannel {
  sms
  email
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

enum AuditSource {
  app
  ai_chat
}

enum CollectionPointType {
  pickup
  dropoff
  both
}

enum ShiftDirection {
  to_practice
  from_practice
}

enum SessionStatus {
  scheduled
  completed
  cancelled
}

enum ShiftStatus {
  open
  claimed
  pending_swap
}

model User {
  id                 String   @id @default(uuid())
  name               String
  phone              String?  @unique
  email              String?  @unique
  languagePreference Language @default(en) @map("language_preference")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  teamMemberships   TeamMember[]
  playerLinks       PlayerParent[]
  sentInvites       Invite[]                 @relation("InvitesCreated")
  otpChallenges     OtpChallenge[]
  sessions          Session[]
  notificationPrefs NotificationPreference[]
  auditLogEntries   AuditLog[]               @relation("AuditActor")
  pushSubscriptions PushSubscription[]
  scheduleTemplates ScheduleTemplate[]       @relation("ScheduleTemplatesCreated")
  assignedShifts    Shift[]                  @relation("ShiftsAssigned")

  @@map("users")
}

model Team {
  id        String   @id @default(uuid())
  name      String
  season    String
  timezone  String   @default("Asia/Jerusalem")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members           TeamMember[]
  players           Player[]
  invites           Invite[]
  notificationPrefs NotificationPreference[]
  auditLogEntries   AuditLog[]
  collectionPoints  CollectionPoint[]
  scheduleTemplates ScheduleTemplate[]
  practiceSessions  PracticeSession[]

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  role     TeamRole @default(parent)
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Player {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  name      String
  age       Int?
  createdAt DateTime @default(now()) @map("created_at")

  team    Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  parents PlayerParent[]

  @@index([teamId])
  @@map("players")
}

model PlayerParent {
  id           String @id @default(uuid())
  playerId     String @map("player_id")
  userId       String @map("user_id")
  relationship String @default("parent")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playerId, userId])
  @@index([userId])
  @@map("player_parents")
}

model Invite {
  id              String       @id @default(uuid())
  teamId          String       @map("team_id")
  code            String       @unique
  phone           String?
  email           String?
  status          InviteStatus @default(pending)
  createdByUserId String       @map("created_by_user_id")
  expiresAt       DateTime     @map("expires_at")
  acceptedAt      DateTime?    @map("accepted_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("InvitesCreated", fields: [createdByUserId], references: [id])

  @@index([teamId])
  @@map("invites")
}

model OtpChallenge {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  channel     OtpChannel
  destination String
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  requestIp   String?    @map("request_ip")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([requestIp, createdAt])
  @@map("otp_challenges")
}

model Session {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model NotificationPreference {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  teamId    String              @map("team_id")
  eventType String              @map("event_type")
  channel   NotificationChannel
  enabled   Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId, eventType, channel])
  @@index([teamId])
  @@map("notification_preferences")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model AuditLog {
  id           String      @id @default(uuid())
  teamId       String      @map("team_id")
  actorId      String?     @map("actor_id")
  actionType   String      @map("action_type")
  targetEntity String      @map("target_entity")
  targetId     String?     @map("target_id")
  beforeState  Json?       @map("before_state")
  afterState   Json?       @map("after_state")
  source       AuditSource @default(app)
  aiContext    Json?       @map("ai_context")
  createdAt    DateTime    @default(now()) @map("created_at")

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([actorId])
  @@index([actionType])
  @@map("audit_logs")
}

model CollectionPoint {
  id        String              @id @default(uuid())
  teamId    String              @map("team_id")
  name      String
  address   String
  gpsLat    Decimal?            @map("gps_lat") @db.Decimal(10, 8)
  gpsLng    Decimal?            @map("gps_lng") @db.Decimal(11, 8)
  type      CollectionPointType
  createdAt DateTime            @default(now()) @map("created_at")

  team               Team                              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  templateDefaults   ScheduleTemplateCollectionPoint[]
  sessionAssignments SessionPointAssignment[]
  shifts             Shift[]

  @@index([teamId])
  @@map("collection_points")
}

model ScheduleTemplate {
  id                   String   @id @default(uuid())
  teamId               String   @map("team_id")
  recurrenceRule       String   @map("recurrence_rule")
  startDate            DateTime @map("start_date") @db.Date
  defaultTime          String   @map("default_time")
  defaultFieldLocation String   @map("default_field_location")
  horizonWeeks         Int      @default(8) @map("horizon_weeks")
  createdByUserId      String   @map("created_by_user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  team             Team                              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy        User                              @relation("ScheduleTemplatesCreated", fields: [createdByUserId], references: [id])
  collectionPoints ScheduleTemplateCollectionPoint[]
  sessions         PracticeSession[]

  @@index([teamId])
  @@map("schedule_templates")
}

model ScheduleTemplateCollectionPoint {
  id         String @id @default(uuid())
  templateId String @map("template_id")
  pointId    String @map("point_id")

  template ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  point    CollectionPoint  @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([templateId, pointId])
  @@map("schedule_template_collection_points")
}

model PracticeSession {
  id            String        @id @default(uuid())
  teamId        String        @map("team_id")
  templateId    String?       @map("template_id")
  startsAt      DateTime      @map("starts_at")
  fieldLocation String        @map("field_location")
  status        SessionStatus @default(scheduled)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  team        Team                     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  template    ScheduleTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignments SessionPointAssignment[]
  shifts      Shift[]

  @@unique([templateId, startsAt])
  @@index([teamId, startsAt])
  @@map("practice_sessions")
}

model SessionPointAssignment {
  id        String         @id @default(uuid())
  sessionId String         @map("session_id")
  pointId   String         @map("point_id")
  direction ShiftDirection
  playerIds String[]       @map("player_ids")

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  point   CollectionPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([sessionId, pointId, direction])
  @@index([pointId])
  @@map("session_point_assignments")
}

model Shift {
  id             String         @id @default(uuid())
  sessionId      String         @map("session_id")
  pointId        String         @map("point_id")
  direction      ShiftDirection
  assignedUserId String?        @map("assigned_user_id")
  status         ShiftStatus    @default(open)
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  session      PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  point        CollectionPoint @relation(fields: [pointId], references: [id], onDelete: Cascade)
  assignedUser User?           @relation("ShiftsAssigned", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@unique([sessionId, pointId, direction])
  @@index([pointId])
  @@index([assignedUserId])
  @@map("shifts")
}
