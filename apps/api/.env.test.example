# Optional overrides for `pnpm run test:integration` (see scripts/reset-test-database.ts).
# Not loaded automatically — these are the same defaults the script already
# falls back to, documented here for discoverability. Set them in your shell
# only if you need a different database than the defaults below (e.g. a
# non-standard Postgres port).

TEST_DATABASE_URL=postgresql://soccer:soccer@localhost:5432/soccer_api_test
TEST_MAINTENANCE_DATABASE_URL=postgresql://soccer:soccer@localhost:5432/postgres
