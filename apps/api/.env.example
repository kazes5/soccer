# Copy to apps/api/.env for local development.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://soccer:soccer@localhost:5432/soccer_dev
REDIS_URL=redis://localhost:6379

# Auth (all optional; defaults shown)
OTP_TTL_MINUTES=10
OTP_MAX_REQUESTS_PER_HOUR=3
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=10
OTP_MAX_VERIFY_ATTEMPTS=5
SESSION_TTL_DAYS=30
INVITE_TTL_DAYS=7

# CORS: must match the web app's origin exactly (optional; default shown)
WEB_ORIGIN=http://localhost:3000

# Set to true only when deployed behind a reverse proxy that sets X-Forwarded-For
# (e.g. behind nginx/ALB/ingress), so request.ip reflects the real client for OTP
# per-IP rate limiting instead of the proxy's own address.
TRUST_PROXY=false
