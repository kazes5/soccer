# Copy to apps/api/.env for local development.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://soccer:soccer@localhost:5432/soccer_dev
REDIS_URL=redis://localhost:6379

# Auth (all optional; defaults shown)
SESSION_TTL_DAYS=30
SYSTEM_ADMIN_ENABLED=false
PASSWORD_LOGIN_MAX_FAILURES_PER_ACCOUNT_PER_HOUR=10
PASSWORD_LOGIN_MAX_FAILURES_PER_IP_PER_HOUR=50
INVITE_CODE_MAX_FAILURES_PER_IP_PER_HOUR=50
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS_PER_ACCOUNT_PER_HOUR=5
PASSWORD_RESET_MAX_REQUESTS_PER_IP_PER_HOUR=20
DEFAULT_PHONE_REGION=IL
INVITE_TTL_DAYS=7

# CORS: must match the web app's origin exactly (optional; default shown)
WEB_ORIGIN=http://localhost:3000

# Set to true only when deployed behind a reverse proxy that sets X-Forwarded-For
# (e.g. behind nginx/ALB/ingress), so request.ip reflects the real client.
TRUST_PROXY=false

# Browser push (all optional; unset means push is simply unavailable — no
# vendor account needed, unlike FCM/APNs). Generate a local dev keypair with
# `pnpm --filter @soccer/api exec web-push generate-vapid-keys` and paste the
# two keys below; VAPID_SUBJECT is a contact URI push services may use to
# reach you about this key pair, conventionally `mailto:`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# AI chat (optional; unset means the chat feature reports itself
# unavailable, same as push above). Get a key at https://openrouter.ai/keys.
# CHAT_CONFIRMATION_SECRET falls back to OPENROUTER_API_KEY if unset.
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# CHAT_CONFIRMATION_SECRET=
CHAT_MAX_REQUESTS_PER_USER_PER_HOUR=30
CHAT_MAX_REQUESTS_PER_IP_PER_HOUR=60
