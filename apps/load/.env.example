# Copy to apps/load/.env for local development.
#
# pnpm test:load resets a dedicated, disposable `soccer_load` database on the
# same Postgres instance `docker compose up -d` already provides, seeds it
# (apps/api/prisma/seed-load.ts), starts real API + worker processes on
# dedicated ports, runs three load scenarios against them, then tears
# everything down.

LOAD_DATABASE_URL=postgresql://soccer:soccer@localhost:5432/soccer_load
LOAD_MAINTENANCE_DATABASE_URL=postgresql://soccer:soccer@localhost:5432/postgres
LOAD_API_PORT=4200
