# Copy to apps/e2e/.env for local development.
#
# The E2E suite runs against dedicated ports (not the ones a developer's own
# `pnpm dev` uses) and a dedicated, disposable database on the same Postgres
# instance `docker compose up -d` already provides — `pnpm --filter @soccer/e2e
# run db:setup` drops and recreates it fresh before every run, so nothing here
# needs to be the shared dev database.

E2E_WEB_PORT=3100
E2E_API_PORT=4100
E2E_DATABASE_URL=postgresql://soccer:soccer@localhost:5432/soccer_e2e
E2E_MAINTENANCE_DATABASE_URL=postgresql://soccer:soccer@localhost:5432/postgres

# Set both to run the whole suite against an already-running deployment
# (e.g. Railway production) instead of local dev servers — see
# playwright.config.ts. Leave unset for the normal local/CI run above.
# E2E_TARGET_WEB_URL=https://soccerweb-production.up.railway.app
# E2E_TARGET_API_URL=https://soccerapi-production.up.railway.app
